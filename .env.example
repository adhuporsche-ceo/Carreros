# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/student_profiling_system

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Mentor Attention Thresholds
ATTENDANCE_ATTENTION_THRESHOLD=75
CGPA_ATTENTION_THRESHOLD=6.5
